# Local runtime state
data/
reports/
*.sqlite3
*.db
*.sqlite

# The hosted teaching demo ships its public, attributed sample corpus, so a
# fresh deployment opens straight into real material. This is the one database
# that is safe to track.
!demo-data/qualicraft.sqlite3

# Credentials and local configuration
.env
.env.*
!.env.example
API_key.txt
api_key.txt
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Editors and OS files
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Local backups made while editing
*.bak

# Website (Next.js) — the source is small; the build output is not.
website/node_modules/
website/.next/
website/out/
website/.data/
website/.env.local

# Next build output, including the stale copy a killed build leaves behind
.next
.next-stale-*
