    "ff6f61db70775456890234ecdec7f928": {
      "annotation_id": "ff6f61db70775456890234ecdec7f928",
      "document_id": "75588a51bbe45322a2413c7ef6c39560",
      "document_name": "interview04-english-excerpts.txt",
      "document_sha256": "72ec8fbfd1c436d3eba6f8c351b3af18802ce7c7f6265ad9de3948e3aa94026b",
      "start": 610,
      "end": 834,
      "quote": "Certainly, however, the field is also opening up with great interest — sometimes through experimental research — to the possibility of digital editions. Digital editions are undoubtedly one of the new frontiers of our field.",
      "source": "manual",
      "code_id": "79349bc905e44ce7a34e37e0f8676ab8",
