    "081a049b2edf5a87a60acfbe4286d851": {
      "annotation_id": "081a049b2edf5a87a60acfbe4286d851",
      "document_id": "75588a51bbe45322a2413c7ef6c39560",
      "document_name": "interview04-english-excerpts.txt",
      "document_sha256": "72ec8fbfd1c436d3eba6f8c351b3af18802ce7c7f6265ad9de3948e3aa94026b",
      "start": 836,
      "end": 1413,
      "quote": "I would add that I work in palaeography and diplomatics. These are two very broad disciplines: connected, but also different. We have always had two strands: a more philological one, traditionally working on codices and books, and a more historical one, working on documents. The Bologna school has tended towards the documentary and diplomatic tradition — the study and editing of documentary sources. I try to carry on that tradition because that is how I was trained, but I am also open to the more philological side. Both interest me, so in practice I move between the two.",
      "source": "manual",
      "code_id": "ebe44b17325045508e4e9e5f26ead62c",
      "code_path": [
        {
          "id": "9d23f9b6eb324571ade7d591d020af55",
          "name": "methodologies and workflows",
          "definition": ""
        },
        {
          "id": "6920f4f9ac944f9a97db6cb3e9184234",
          "name": "macrodiscipline 1 - philology and literature",
          "definition": ""
        },
        {
          "id": "e957849e76c74838a2d31322a27b7cb4",
          "name": "methodology-inclined",
          "definition": ""
        },
        {
          "id": "ebe44b17325045508e4e9e5f26ead62c",
          "name": "difference between paleography and diplomatics",
          "definition": ""
        }
      ]
    },
    "385e5468906559869404264689236561": {
      "annotation_id": "385e5468906559869404264689236561",
      "document_id": "8c17e627c7d85f7c8967047bfa92531b",
      "document_name": "interview02-english-excerpts.txt",
      "document_sha256": "be1817ce96cd101e2ecf98b1bdcb6cdd257b98251deb502633d002e00913e46a",
      "start": 402,
      "end": 894,
      "quote": "This is [something new] compared with when I began this kind of research. Fifteen years ago I would of course have had to go to the library. Now one edition has been digitised by Google Books, while for the 1502 edition we used the digitised print from the Bavarian State Library in Munich, which is an exceptional repository of early printed books. Seventy per cent of what we look for among incunabula, late-fifteenth-century printed books and sixteenth-century editions can be found there.",
      "source": "manual",
      "code_id": "72b86059824e4ed5973875f0ee7ddff3",
      "code_path": [
        {
          "id": "b9fe6efc1e1348dd9f4b21a1bdb2ecf8",
          "name": "materials",
          "definition": ""
        },
        {
          "id": "02554c7f12a94e4caa0807a6b75d4b82",
          "name": "digital representations of cultural objects",
          "definition": ""
        },
        {
          "id": "d7e4832a27f2406d9588a625c7dc8628",
          "name": "pros of using facsimiles and photographs",
          "definition": ""
        },
        {
