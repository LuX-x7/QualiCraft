    "3eaf388f66c25fed99bd29a341820a59": {
      "annotation_id": "3eaf388f66c25fed99bd29a341820a59",
      "document_id": "75588a51bbe45322a2413c7ef6c39560",
      "document_name": "interview04-english-excerpts.txt",
      "document_sha256": "72ec8fbfd1c436d3eba6f8c351b3af18802ce7c7f6265ad9de3948e3aa94026b",
      "start": 0,
      "end": 608,
      "quote": "Generally speaking, the object of my studies — given the nature of my discipline — is manuscript sources, usually from the medieval and/or Renaissance period. Manuscripts is a broad term, and I use it broadly: it can mean codices, manuscript books, or handwritten documents. These can of course be very different, with different materials and supports: often parchment, but also paper. They are always manuscript sources. My work is, as it were, to elucidate these sources and make them accessible, through a critical edition or through studies, to people working in history, philology, literature and so on.",
      "source": "manual",
      "code_id": "84ccd1f91e6948268e63beecf88b3303",
      "code_path": [
        {
          "id": "b9fe6efc1e1348dd9f4b21a1bdb2ecf8",
          "name": "materials",
          "definition": ""
        },
        {
          "id": "d050cb3e46234516980d0f5f4371b06d",
          "name": "ancient manuscripts and early printed books",
          "definition": ""
        },
        {
          "id": "84ccd1f91e6948268e63beecf88b3303",
          "name": "manuscripts from the Middle Ages",
          "definition": ""
        }
      ]
    },
