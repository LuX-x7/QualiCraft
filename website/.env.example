# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty and the kernel boots an embedded Postgres (PGlite)
# that persists to ./.data/pg. It needs no external service, which is why this
# example does not spell out a connection string. Set DATABASE_URL only when
# moving to a hosted database.

# --- Auth -----------------------------------------------------------------
# 32+ random chars. Used to sign admin session cookies.
AUTH_SECRET=change-me-to-a-long-random-string

# --- Media ----------------------------------------------------------------
# Optional. Without it uploads land in ./public/uploads (dev only).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- First admin account (used only when the users table is empty) ---------
SEED_ADMIN_EMAIL=admin@internationalstudycouncil.com
SEED_ADMIN_PASSWORD=changeme123
