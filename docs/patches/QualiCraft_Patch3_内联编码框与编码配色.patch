+/* --- Inline coding popup -----------------------------------------------------
+   Selecting text opens a small box anchored to the selection instead of a bar at
+   the bottom of the reading pane. The box carries a keyword field with
+   autocomplete: Enter applies the top match, or creates the code if nothing
+   matches. ::highlight(pending) keeps the selection visible after focus moves
+   into the field (a normal selection would be cleared by the focus change). */
+.code-popup{position:fixed;z-index:20;width:332px;border:1px solid var(--strong);border-radius:5px;background:#fff;box-shadow:0 12px 34px #17203326;font-size:12px}
+.code-popup-row{display:flex;align-items:center;gap:6px;padding:7px 8px 7px 11px;border-bottom:1px solid var(--line)}
+.code-popup-row input{flex:1;min-width:0;border:0;outline:0;padding:4px 0;font:13px var(--sans);color:var(--ink);background:transparent}
+.code-popup-x{flex:0 0 auto;border:0;background:transparent;color:var(--subtle);font-size:12px;padding:2px 5px}
+.code-popup-x:hover{color:var(--ink)}
+.code-suggest{max-height:212px;overflow:auto;padding:4px}
+.suggest-row{display:flex;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:7px 8px;border-radius:3px;text-align:left;font-size:12px;color:#404b5e}
+.suggest-row .dot{flex:0 0 8px;width:8px;height:8px;border-radius:2px}
+.suggest-row .suggest-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.suggest-row .suggest-tag{flex:0 0 auto;font-size:8px;letter-spacing:.06em;color:#7b8494;background:#eef0f3;border-radius:2px;padding:1px 4px}
+.suggest-row.active,.suggest-row:hover{background:#eef1f9}
+.suggest-row.create{color:var(--accent);font-weight:600;border-top:1px solid var(--line);border-radius:0}
+.suggest-empty{padding:14px 10px;color:var(--subtle);font-size:11px;text-align:center}
+.code-popup-foot{display:flex;align-items:center;gap:6px;padding:7px 9px;border-top:1px solid var(--line);background:#fafbfc;border-radius:0 0 5px 5px}
+.code-popup-count{flex:1;color:var(--subtle);font-size:10px}
+.code-popup-foot button{font-size:10px;padding:4px 7px}
+::highlight(pending){background:color-mix(in srgb,#4656a6 30%,transparent)}
