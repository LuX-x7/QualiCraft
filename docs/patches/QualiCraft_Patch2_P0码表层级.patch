+/* --- Codebook hierarchy (schema v2) -----------------------------------------
+   The codebook became a tree so codes can be grouped into themes. Each row is
+   indented by its depth, parents show a twisty and a rolled-up count, and the
+   per-row edit affordance stays out of the way until hover. */
+.code-row{display:flex;align-items:center;gap:1px;padding-left:calc(var(--depth,0) * 13px)}
+.code-row .side-item{flex:1;min-width:0}
+.twisty{flex:0 0 16px;width:16px;border:0;background:transparent;padding:3px 0;color:#8a93a3;font-size:9px;line-height:1;text-align:center;cursor:pointer}
+.twisty:hover{color:#4656a6}
+.twisty.leaf{cursor:default;pointer-events:none}
+.edit-code{flex:0 0 18px;width:18px;border:0;background:transparent;padding:3px 0;color:#9aa3b2;font-size:13px;line-height:1;opacity:0}
+.code-row:hover .edit-code,.code-row:focus-within .edit-code{opacity:1}
+.edit-code:hover{color:var(--accent)}
+.status-flag{font-size:7px;letter-spacing:.06em;text-transform:uppercase;color:#8a6d1f;background:#fdf4d8;border-radius:2px;padding:1px 3px;margin-left:4px;vertical-align:1px}
+button.danger{border-color:#d8b4b4;background:#fff;color:var(--danger)}
+button.danger:hover{border-color:var(--danger);background:#fdf3f3}
